# Transilvania Cave Diving — Environment Configuration Example
# Copy this file to .env.local for local development or .env for production deployment.
# Never commit real credentials, tokens, or secrets to version control.

# Canonical Public Site URL (used for canonical tags, sitemaps, JSON-LD, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://transilvaniacavediving.com

# Application Runtime Environment
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Contact Inquiry Handling & Email (Hostico SMTP / Webhook)
CONTACT_NOTIFICATION_EMAIL=contact@transilvaniacavediving.com
CONTACT_WEBHOOK_URL=
CONTACT_RATE_LIMIT_MAX_PER_HOUR=10

# Hostico SMTP Configuration (update with your hosting credentials)
# SMTP_HOST=mail.transilvaniacavediving.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=contact@transilvaniacavediving.com
# SMTP_PASS=

# Security & Admin Configuration (/administrator)
# Set your strong administrator password here (checked by /api/admin/auth)
ADMIN_PASSWORD=password
SESSION_SECRET=replace-with-at-least-32-bytes-of-cryptographic-randomness
CSP_REPORT_URI=
